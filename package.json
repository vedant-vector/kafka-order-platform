{
  "name": "@kafka-order-platform/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/order-service/schema.prisma && prisma generate --schema=prisma/inventory-service/schema.prisma",
    "prisma:migrate:order": "prisma migrate deploy --schema=prisma/order-service/schema.prisma",
    "prisma:migrate:inventory": "prisma migrate deploy --schema=prisma/inventory-service/schema.prisma",
    "prisma:migrate": "npm run prisma:migrate:order && npm run prisma:migrate:inventory",
    "prisma:seed:inventory": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/inventory-service/seed.ts",
    "db:up": "docker compose up -d postgres",
    "db:setup": "npm run db:up && npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed:inventory",
    "postinstall": "npm run prisma:generate"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/nest": "22.7.5",
    "@nx/node": "22.7.5",
    "@nx/web": "22.7.5",
    "@nx/webpack": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "20.19.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "22.7.5",
    "prettier": "~3.6.2",
    "prisma": "^6.19.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
