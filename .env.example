# PostgreSQL (shared server, separate databases per service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# order-service
ORDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_db?schema=public

# inventory-service
INVENTORY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_db?schema=public

# Kafka (used in later steps)
KAFKA_BROKERS=localhost:9092
